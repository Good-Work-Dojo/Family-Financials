# Deployment settings for compose.yaml: copy this file to .env beside it and change what your machine needs. It holds
# no secret: the passcodes, the bank feed's access URL, the AI key and the alert credentials are files under secrets/,
# each read only by the service that needs it. An empty value takes compose.yaml's default.

# FF_BIND: the address the dashboard listens on: 127.0.0.1 (this machine only), or its address on the home network, such as 192.0.2.10.
# Any other address serves every device on that network over plain HTTP unless SITE_ADDRESS is a domain, so the passcode and the session cookie cross it in clear; 0.0.0.0 is every interface.
FF_BIND=127.0.0.1
# FF_PORT: the port it listens on, so by default it answers at http://127.0.0.1:8080 on this machine; pick a free one.
FF_PORT=8080
# FF_PORT_TLS: the HTTPS port, used only when SITE_ADDRESS is a domain. For a domain, such as dash.example.net, set FF_BIND=0.0.0.0, FF_PORT=80, FF_PORT_TLS=443 and SITE_ADDRESS to the name.
FF_PORT_TLS=8443
# FF_UID: the user the four services run as, who owns the install's directories: the output of `id -u`.
FF_UID=1000
# FF_GID: that user's group: the output of `id -g`.
FF_GID=1000
# SITE_ADDRESS: what the web server serves as inside its container: :8080, plain HTTP on the port compose publishes, or a domain name such as dash.example.net for automatic HTTPS.
SITE_ADDRESS=:8080
# FF_HOSTNAMES: other names the dashboard answers to, separated by spaces, such as dash.example.net behind a proxy (none by default).
FF_HOSTNAMES=
# TRUSTED_PROXIES: the address ranges of a proxy in front whose X-Forwarded-For is believed, such as 192.0.2.0/24 (none by default).
TRUSTED_PROXIES=
# FF_IMAGE_WEB: the web server's image (empty: compose.yaml's default, this release's published web image).
FF_IMAGE_WEB=
# FF_IMAGE_ETL: the image the store, the scheduler and the refresher run (empty: compose.yaml's default, this release's published ETL image).
FF_IMAGE_ETL=
